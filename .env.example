# Portainer stack variables; defaults below work for demo mode.
# Set this to the Docker Hub account that publishes rail.
DOCKERHUB_USERNAME=jonesdavidj
RAIL_IMAGE_TAG=main
RAIL_CONTAINER_NAME=rail
RAIL_RESTART_POLICY=unless-stopped
TZ=Europe/London
RAIL_HOST_PORT=8097
RAIL_DATA_VOLUME=rail-data
RAIL_TMP_SIZE=16m
RAIL_READ_ONLY=true
# Leave empty for demo deployment. Live integration is not implemented.
RAIL_DATA_API_KEY=
RAIL_PROVIDER=demo
RAIL_DATA_PATH=/data
