# Portainer stack variables. Keep demo until ready to enable the live provider.
DOCKERHUB_USERNAME=jonesdavidj
RAIL_IMAGE_TAG=main
RAIL_CONTAINER_NAME=rail
RAIL_PLATFORM=linux/amd64
RAIL_RESTART_POLICY=unless-stopped
TZ=Europe/London
RAIL_HOST_PORT=8097
RAIL_DATA_VOLUME=rail-data
RAIL_TMP_SIZE=16m
RAIL_READ_ONLY=true
RAIL_PROVIDER=demo
RAIL_DATA_PATH=/data
# For live mode: set RAIL_PROVIDER=auto or rail_data and use the RDM Specification URL.
RAIL_DATA_BASE_URL=
RAIL_DATA_ALLOWED_HOSTS=api1.raildata.org.uk
# Supply exactly one of these; the file must be mounted and readable inside the container.
RAIL_DATA_API_KEY=
RAIL_DATA_API_KEY_FILE=
# Optional: require this Bearer token for route writes.
ADMIN_TOKEN=
RAIL_CACHE_TTL=30
RAIL_REFRESH_SECONDS=30
