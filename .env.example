# Documentation only: supply all values as Portainer stack variables.
RAIL_IMAGE=jonesdavidj/rail:phase-2
RAIL_PLATFORM=linux/amd64
RAIL_HOST_PORT=8097
RAIL_VOLUME_NAME=rail-data
RAIL_DATA_PATH=/data
TZ=Europe/London
# auto selects live when a key/file is configured; otherwise clearly labelled Demo.
RAIL_PROVIDER=auto
# Paste the base URL including /LDBWS/api/20220120 from the RDM Specification tab.
RAIL_DATA_BASE_URL=
RAIL_DATA_ALLOWED_HOSTS=api1.raildata.org.uk
# Supply exactly one of these. A file path must refer to a mounted container file.
RAIL_DATA_API_KEY=
RAIL_DATA_API_KEY_FILE=
# Optional Bearer token required for POST/PUT/DELETE when nonempty.
ADMIN_TOKEN=
RAIL_CACHE_TTL=30
RAIL_REFRESH_SECONDS=30
