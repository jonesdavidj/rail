# Documentation only: set these as Portainer stack variables in production.
RAIL_IMAGE=jonesdavidj/rail:phase-1
RAIL_PLATFORM=linux/amd64
RAIL_HOST_PORT=8097
RAIL_VOLUME_NAME=rail-data
RAIL_DATA_PATH=/data
RAIL_PROVIDER=demo
TZ=Europe/London
# Phase 2 will introduce RAIL_DATA_API_KEY and RAIL_DATA_BASE_URL.
# No key is read or needed in phase 1. rail_data mode returns HTTP 503.
